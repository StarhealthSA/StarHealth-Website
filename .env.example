# Firebase client (public — used for admin login UI)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Optional fallback if the public bucket name differs on server
FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server only — never expose to browser)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: WhatsApp number for service page CTAs (digits only, with country code)
NEXT_PUBLIC_WHATSAPP_NUMBER=966505730003

# Optional: Google Cloud Translation API key for admin auto-translate (EN → AR)
# Without this, a free MyMemory fallback is used (rate-limited).
GOOGLE_TRANSLATE_API_KEY=

# EmailJS — contact form emails are sent from the browser (see NEXT_PUBLIC_* below).
# Server keys are optional (for future server-side sends); enable non-browser API at:
# https://dashboard.emailjs.com/admin/account/security
EMAILJS_SERVICE_ID=service_gr3hz0c
EMAILJS_PUBLIC_KEY=3hR26mPB0OTAoNfhQ
EMAILJS_PRIVATE_KEY=
EMAILJS_ENQUIRY_TEMPLATE_ID=template_jdttqx9
EMAILJS_APPOINTMENT_TEMPLATE_ID=template_zi5qnzk

# Browser EmailJS (required for contact form & appointment emails)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_gr3hz0c
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=3hR26mPB0OTAoNfhQ
NEXT_PUBLIC_EMAILJS_ENQUIRY_TEMPLATE_ID=template_jdttqx9
NEXT_PUBLIC_EMAILJS_APPOINTMENT_TEMPLATE_ID=template_zi5qnzk

# Admin roles (set via CLI, not env): super_admin | admin | editor | viewer
# Bootstrap super admin once: node scripts/set-admin-role.js your@email.com super_admin
