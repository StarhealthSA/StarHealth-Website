rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(roles) {
      return isSignedIn() && request.auth.token.role in roles;
    }

    function isAdminReader() {
      return hasRole(['super_admin', 'admin', 'editor', 'viewer']);
    }

    function isAdminWriter() {
      return hasRole(['super_admin', 'admin', 'editor']);
    }

    function isAdminDeleter() {
      return hasRole(['super_admin', 'admin']);
    }

    function isValidAppointmentCreate() {
      let data = request.resource.data;
      return data.keys().hasAll(['doctorId', 'patientName', 'phone', 'status'])
        && data.doctorId is string
        && data.doctorId.size() > 0
        && data.patientName is string
        && data.patientName.size() > 0
        && data.patientName.size() <= 200
        && data.phone is string
        && data.phone.size() > 0
        && data.phone.size() <= 30
        && data.status == 'booked'
        && (!('read' in data) || data.read == false)
        && (!('source' in data) || data.source == 'website');
    }

    function isValidEnquiryCreate() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'phone', 'email'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 200
        && data.phone is string
        && data.phone.size() > 0
        && data.phone.size() <= 30
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 320
        && (!('read' in data) || data.read == false)
        && (!('source' in data) || data.source == 'website');
    }

    // --- Public CMS content: read published/active only; admins manage ---

    match /doctors/{doctorId} {
      allow read: if resource.data.status == 'active'
        || resource.data.published == true
        || isAdminReader();
      allow create, update: if isAdminWriter();
      allow delete: if isAdminDeleter();
    }

    match /services/{serviceId} {
      allow read: if resource.data.published == true
        || resource.data.status == 'active'
        || isAdminReader();
      allow create, update: if isAdminWriter();
      allow delete: if isAdminDeleter();
    }

    match /serviceCategories/{categoryId} {
      allow read: if resource.data.active == true || isAdminReader();
      allow create, update: if isAdminWriter();
      allow delete: if isAdminDeleter();
    }

    match /specializations/{specId} {
      allow read: if resource.data.active == true || isAdminReader();
      allow create, update: if isAdminWriter();
      allow delete: if isAdminDeleter();
    }

    match /blogs/{blogId} {
      allow read: if resource.data.status == 'active'
        || resource.data.published == true
        || isAdminReader();
      allow create, update: if isAdminWriter();
      allow delete: if isAdminDeleter();
    }

    // --- Public submissions: create only; no client reads ---

    match /appointments/{appointmentId} {
      allow read: if isAdminReader();
      allow create: if isValidAppointmentCreate();
      allow update: if isAdminWriter();
      allow delete: if isAdminDeleter();
    }

    match /enquiries/{enquiryId} {
      allow read: if isAdminReader();
      allow create: if isValidEnquiryCreate();
      allow update: if isAdminWriter();
      allow delete: if isAdminDeleter();
    }

    // --- Server-only via Admin SDK (block all direct client access) ---

    match /siteSettings/{docId} {
      allow read, write: if false;
    }

    // Deny any collection not listed above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
