rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(roles) {
      return isSignedIn() && request.auth.token.role in roles;
    }

    match /doctors/{doctorId} {
      allow read: if resource.data.status == 'active' || resource.data.published == true || hasRole(['super_admin', 'admin', 'editor', 'viewer']);
      allow create, update: if hasRole(['super_admin', 'admin', 'editor']);
      allow delete: if hasRole(['super_admin', 'admin']);
    }

    match /services/{serviceId} {
      allow read: if resource.data.published == true
        || resource.data.status == 'active'
        || hasRole(['super_admin', 'admin', 'editor', 'viewer']);
      allow create, update: if hasRole(['super_admin', 'admin', 'editor']);
      allow delete: if hasRole(['super_admin', 'admin']);
    }

    match /serviceCategories/{categoryId} {
      allow read: if resource.data.active == true || hasRole(['super_admin', 'admin', 'editor', 'viewer']);
      allow create, update: if hasRole(['super_admin', 'admin', 'editor']);
      allow delete: if hasRole(['super_admin', 'admin']);
    }

    match /specializations/{specId} {
      allow read: if resource.data.active == true || hasRole(['super_admin', 'admin', 'editor', 'viewer']);
      allow create, update: if hasRole(['super_admin', 'admin', 'editor']);
      allow delete: if hasRole(['super_admin', 'admin']);
    }

    match /blogs/{blogId} {
      allow read: if resource.data.status == 'active'
        || resource.data.published == true
        || hasRole(['super_admin', 'admin', 'editor', 'viewer']);
      allow create, update: if hasRole(['super_admin', 'admin', 'editor']);
      allow delete: if hasRole(['super_admin', 'admin']);
    }

    match /appointments/{appointmentId} {
      allow read, write: if false;
    }

    match /siteSettings/{docId} {
      allow read, write: if false;
    }
  }
}
