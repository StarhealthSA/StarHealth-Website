rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(roles) {
      return isSignedIn() && request.auth.token.role in roles;
    }

    function isAdminWriter() {
      return hasRole(['super_admin', 'admin', 'editor']);
    }

    function isAdminDeleter() {
      return hasRole(['super_admin', 'admin']);
    }

    // CMS folders used by the admin upload API
    function isKnownUploadPath(path) {
      return path.matches(
        '^(doctors|services|specializations|blogs|homepage|uploads)(/.*)?$'
      );
    }

    function isAllowedContentType() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('video/(mp4|webm|quicktime)');
    }

    function isAllowedFileSize() {
      // Images ~10 MB; videos/reels ~100 MB
      return (request.resource.contentType.matches('image/.*')
          && request.resource.size < 10 * 1024 * 1024)
        || (request.resource.contentType.matches('video/(mp4|webm|quicktime)')
          && request.resource.size < 100 * 1024 * 1024);
    }

    match /{allPaths=**} {
      // Public website serves doctor photos, service images, blog media, hero videos, etc.
      allow read: if true;

      allow create, update: if isAdminWriter()
        && isKnownUploadPath(allPaths)
        && isAllowedContentType()
        && isAllowedFileSize();

      allow delete: if isAdminDeleter()
        && isKnownUploadPath(allPaths);
    }
  }
}
